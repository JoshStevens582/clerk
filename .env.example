OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
PAGES_DIR=./pages
DATABASE_URL=sqlite:///./data/clerk.db
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
SESSION_SECRET=change-me-in-production
# v2 staff accounts (seeded once when staff_users is empty):
# user:password or user:password:manager — comma-separated
CLERK_BOOTSTRAP_STAFF=owner:demo-owner:manager,reception:demo-reception:staff
CLERK_ADMIN_USERNAMES=owner
# Deprecated v1 single password (only used if CLERK_BOOTSTRAP_STAFF is empty):
OWNER_PASSWORD=demo-owner
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=40
RATE_LIMIT_GLOBAL_PER_DAY=200
LOG_LEVEL=INFO
