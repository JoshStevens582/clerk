OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
PAGES_DIR=./pages
DATABASE_URL=sqlite:///./data/clerk.db
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
# Required in production (>= 32 bytes). Same role as ATLAS_AUTH_SECRET.
CLERK_AUTH_SECRET=local-dev-only-not-for-production-use-32b
CLERK_BOOTSTRAP_STAFF=owner:demo-owner:manager,reception:demo-reception:staff
CLERK_ADMIN_USERNAMES=owner
# Public one-click demo (pipe-separated user:pass:role). Empty disables demo login.
CLERK_DEMO_USERS=demo:TryClerk2026:staff
OWNER_PASSWORD=demo-owner
REDIS_URL=redis://127.0.0.1:6379/1
REDIS_REQUIRED=false
LOGIN_LOCKOUT_ENABLED=true
LOGIN_LOCKOUT_FAIL_CLOSED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_CLOSED=true
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=40
RATE_LIMIT_GLOBAL_PER_DAY=200
APP_PUBLIC_URL=https://agent.customchatandautomation.co.za
PASSWORD_RESET_EXPOSE_TOKEN_IN_RESPONSE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Cape Town Physio <noreply@yourdomain.co.za>
SMTP_USE_TLS=true
# Optional: POST /api/hooks/inbound with header X-Clerk-Inbound-Secret
CLERK_INBOUND_WEBHOOK_SECRET=
# Resend receiving (launch): webhook /api/hooks/resend, event email.received
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
CLERK_INBOUND_ADDRESS=clerk@customchatandautomation.co.za
CLERK_SEED_DEMO_INBOX=true
# WhatsApp Cloud API (Meta). Approved WhatsApp drafts send when the token and phone number id are set.
# Webhook URL for inbound: https://<your-host>/api/hooks/whatsapp (subscribe to "messages").
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_DEFAULT_COUNTRY_CODE=27
LOG_LEVEL=INFO
